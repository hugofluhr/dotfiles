# History
HISTSIZE=5000
SAVEHIST=5000
HISTFILE=~/.zsh_history
setopt histignorealldups sharehistory incappendhistory

# Keybindings
bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

# Keep forwarded ssh-agent working across tmux reattaches.
#
# tmux panes capture SSH_AUTH_SOCK from the environment at the moment
# they're created and never update it. Each fresh SSH login hands out a
# new agent socket (/tmp/ssh-XXXX/agent.NNNN), so panes created under an
# earlier connection end up pointing at a socket that's gone -- `git
# pull` then fails with "Could not open a connection to your
# authentication agent." Route through one fixed path instead: relink it
# to the live socket on every login (outside tmux only), and every pane
# -- old or new -- just resolves the same stable path each time it's used.
if [[ -n "$SSH_CONNECTION" && -z "$TMUX" && -n "$SSH_AUTH_SOCK" && -S "$SSH_AUTH_SOCK" ]]; then
    mkdir -p ~/.ssh
    ln -sf "$SSH_AUTH_SOCK" ~/.ssh/ssh_auth_sock.tmux
fi
[[ -S ~/.ssh/ssh_auth_sock.tmux ]] && export SSH_AUTH_SOCK=~/.ssh/ssh_auth_sock.tmux

# Cluster init scripts
source /etc/profile.d/lmod.sh
source /etc/profile.d/spack.sh
source /etc/profile.d/slurm.sh
source /etc/profile.d/z01_lmodenv.sh

# >>> conda initialize (cluster module) >>>
# Uses the cluster's admin-maintained miniforge3 module instead of a
# home-directory install. `module load` alone only puts conda on PATH
# (CONDA_SHLVL=0); source its conda.sh to get `conda activate` as a
# shell function too.
module load miniforge3 &>/dev/null
if [ -n "$CONDA_EXE" ]; then
    CONDA_BASE="${CONDA_EXE%/bin/conda}"
    source "$CONDA_BASE/etc/profile.d/conda.sh"
    [ -f "$CONDA_BASE/etc/profile.d/mamba.sh" ] && source "$CONDA_BASE/etc/profile.d/mamba.sh"
fi
# <<< conda initialize <<<

# Completion
autoload -Uz compinit && compinit

zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*' verbose true
zstyle ':completion:*' matcher-list '' 'm:{a-z}={A-Z}' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=* l:|=*'
# Typo-tolerant fallback: exact match first, then case-insensitive, then fuzzy.
zstyle ':completion:*' completer _complete _match _approximate
eval "$(dircolors -b)"
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
zstyle ':completion:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,cmd'

# zsh-autosuggestions: fish-style inline suggestion from history, accept with →.
# Single-file plugin, no framework needed -- cloned by install.sh --cluster
# into ~/.zsh-plugins (kept outside the dotfiles repo's .zsh/ symlink).
[[ -f ~/.zsh-plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
    source ~/.zsh-plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

# fzf key-bindings only (Ctrl-R history, Ctrl-T/Alt-C fuzzy file/dir insert).
# Deliberately skips completion.zsh: fzf's `**<Tab>` trigger completion is
# opt-in syntax you have to remember, not real autocomplete -- not worth it.
[[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]] && \
    source /usr/share/doc/fzf/examples/key-bindings.zsh

# Prompt: green bold user@host, cyan truncated path, red exit code on failure
# Right prompt: timestamp (useful for tracking when commands finish)
PROMPT='%(?::%F{red}[%?]%f )%B%F{green}%n@%m%f%b:%F{cyan}%(4~|…/%3~|%~)%f
%# '
RPROMPT='%F{240}%*%f'

# Aliases
alias ls='ls --color=auto'
alias ll='ls -lh --color=auto'
alias la='ls -lah --color=auto'

# Auto-attach to a persistent tmux session on interactive SSH logins.
# Opt in with: touch ~/.tmux_autostart
[[ -f ~/.zsh/tmux_autostart.zsh ]] && source ~/.zsh/tmux_autostart.zsh
