# Minimal tmux config for the UZH sciencecluster (and anywhere else without
# a guaranteed truecolor terminal or Nerd Font on the connecting client).
# See .tmux.conf for the full Ghostty/macOS version -- this intentionally
# doesn't share code with it, same split as .zshrc vs .zshrc.cluster.
#
# What's dropped and why:
#   - No truecolor hex backgrounds. The cluster's terminfo entries report
#     256 colors but no Tc/RGB capability, and the SSH client on the other
#     end isn't guaranteed to be Ghostty (or to share its background color),
#     so a hardcoded bg would just as likely clash as match.
#   - No Nerd Font powerline glyphs. Can't assume the connecting terminal
#     has one patched in. Plain ASCII brackets instead.
#   - Bar background left unset (inherits the terminal's own), so it never
#     looks like a mismatched rectangle.

set -g default-terminal "tmux-256color"

# Prefix: Ctrl-Space, same as the main config.
unbind C-b
set -g prefix C-Space
bind C-Space send-prefix

# Mouse left off on purpose. With it on, tmux captures every mouse event
# and drag-to-select becomes *tmux's* copy-mode selection, not the
# terminal's -- so it lands in tmux's paste buffer (prefix+]) but never in
# the Mac's real clipboard, since OSC 52 passthrough proved unreliable over
# this SSH path. With mouse off, Ghostty handles selection itself: drag to
# select, Cmd+C to copy, works like any local terminal. Trade-off: no
# mouse-driven pane switch/resize, and scrolling uses Ghostty's own
# scrollback instead of tmux's pane history.
set -g mouse off
set -g base-index 1
setw -g pane-base-index 1
set -g history-limit 50000
set -sg escape-time 10

# Keyboard-driven copy-mode (prefix+[) still works without the mouse, and
# still benefits from OSC 52 so a `y` in copy-mode reaches the real
# clipboard too, not just tmux's internal buffer.
set -g set-clipboard on
set -as terminal-overrides ',*:Ms=\E]52;c;%p2%s\007'

# Split keys: - and . sit next to each other, no AltGr needed on Swiss layout
bind - split-window -v -c "#{pane_current_path}"
bind . split-window -h -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"

# Status bar -- solid 256-color bg (colour237, a mid-dark gray safe on any
# 256-color terminal, no truecolor needed) so the bar reads as a lighter
# strip above whatever background the connecting terminal happens to
# have. No nerdfont glyphs (can't assume a patched font
# on the client side). Session and active-window chips get a real fill too,
# using the same 97/67/71 palette as the macOS config.
set -g status-interval 5
set -g status-justify left
set -g status-style "bg=colour237,fg=colour255"

set -g status-left-length 30
set -g status-left "#[bg=colour97,fg=colour255,bold]  #S  "

setw -g window-status-style "fg=colour250,bg=colour237"
setw -g window-status-format " #I:#W "
setw -g window-status-current-format "#[bg=colour67,fg=colour255,bold]  #I:#W  "
setw -g window-status-separator ""

set -g status-right-length 40
set -g status-right "#[fg=colour250,bg=colour237] %d %b #[bg=colour71,fg=colour255,bold]  %H:%M  "

set -g pane-border-style "fg=colour238"
set -g pane-active-border-style "fg=colour67"
set -g message-style "fg=colour67,bold"
set -g message-command-style "fg=colour67,bold"
