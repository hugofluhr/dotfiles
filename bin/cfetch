#!/usr/bin/env bash
# cfetch -- interactively pick files or directories on the UZH sciencecluster
# and rsync them down to this machine.
#
# Usage: cfetch [-d] [-L] [-m depth] [-c] [-r] [-p] [-n] [-H host] <remote-dir> [local-dest]
#   -d        directory mode: list directories with their aggregate sizes and
#             transfer whole subtrees, rather than listing individual files
#   -L        follow symlinks (by default symlinked files are skipped entirely)
#   -m depth  limit depth. In file mode this prunes the walk and so genuinely
#             costs less; in directory mode du must stat everything regardless,
#             so it only trims what gets displayed
#   -c        reuse a cached listing if one exists, else build and save one
#   -r        rebuild the cached listing (implies -c)
#   -p        preview the hovered entry over ssh (one remote call per move)
#   -n        rsync dry run -- report what would transfer, copy nothing
#   -H host   ssh host alias (default: uzh.cluster.cmd)
#
# Tab marks entries and Enter transfers them. Search matches on the path only,
# so the size column never interferes; filter first and then ctrl-a to take
# everything matching. Paths are recreated relative to <remote-dir> underneath
# <local-dest> (default: the current directory).
#
# The listing costs one bounded metadata walk on the login node. That is fine
# for a project subtree and not fine for a whole /shares/<account> root; use
# `ncdu -o` from a batch job to work out which subtree you want first. Pass -c
# when you expect to revisit a tree, so the walk happens once rather than once
# per invocation.
set -euo pipefail

HOST="uzh.cluster.cmd"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cfetch"
dirs_mode=0
follow=0
max_depth=""
use_cache=0
refresh=0
preview=0
dry_run=0

usage() { sed -n '2,${/^#/!q;s/^# \{0,1\}//;p;}' "$0" >&2; exit 1; }

while getopts "dLm:crpnH:h" opt; do
  case $opt in
    d) dirs_mode=1 ;;
    L) follow=1 ;;
    m) max_depth=$OPTARG ;;
    c) use_cache=1 ;;
    r) use_cache=1; refresh=1 ;;
    p) preview=1 ;;
    n) dry_run=1 ;;
    H) HOST=$OPTARG ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

[ $# -ge 1 ] || usage
REMOTE_DIR=${1%/}
DEST=${2:-.}

case $max_depth in
  ''|*[!0-9]*) [ -z "$max_depth" ] || { echo "cfetch: -m takes a number" >&2; exit 1; } ;;
esac

command -v fzf >/dev/null || { echo "cfetch: fzf not found in PATH" >&2; exit 1; }

# Resolve <remote-dir> against the *remote* home. A leading "~" reaches us only
# if it was quoted; unquoted, the local shell has already expanded it to this
# Mac's $HOME, which is never a path that exists on the cluster. Handle both
# spellings, plus bare relative paths. Genuine absolute paths (/shares/...)
# pass through untouched and cost no extra round trip.
case $REMOTE_DIR in
  "$HOME"|"$HOME"/*) REMOTE_DIR=${REMOTE_DIR#"$HOME"}; need_home=1 ;;
  '~'|'~'/*)         REMOTE_DIR=${REMOTE_DIR#\~};      need_home=1 ;;
  /*)                need_home=0 ;;
  *)                 REMOTE_DIR="/$REMOTE_DIR";        need_home=1 ;;
esac

if [ "$need_home" -eq 1 ]; then
  remote_home=$(ssh "$HOST" 'echo $HOME')
  [ -n "$remote_home" ] || { echo "cfetch: could not resolve \$HOME on $HOST" >&2; exit 1; }
  REMOTE_DIR="${remote_home}${REMOTE_DIR}"
fi

# Wrap a string in single quotes for safe expansion by the remote shell.
shquote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Both modes emit the same contract: raw byte size, tab, path. du already uses
# that format, and find is told to match it. Normalising "./" prefixes and
# dropping the root entry happens locally, below.
build_listing() {
  local cmd
  if [ "$dirs_mode" -eq 1 ]; then
    cmd="du -b"
    [ "$follow" -eq 1 ] && cmd="$cmd -L"
    [ -n "$max_depth" ] && cmd="$cmd --max-depth=$max_depth"
    cmd="$cmd . 2>/dev/null | sort -rn"
    echo "cfetch: measuring directories under $HOST:$REMOTE_DIR ..." >&2
  else
    cmd="find"
    [ "$follow" -eq 1 ] && cmd="$cmd -L"
    cmd="$cmd ."
    [ -n "$max_depth" ] && cmd="$cmd -maxdepth $max_depth"
    cmd="$cmd -type f -printf '%s\t%P\n' 2>/dev/null | sort -rn"
    echo "cfetch: walking $HOST:$REMOTE_DIR ..." >&2
  fi
  ssh "$HOST" "cd $(shquote "$REMOTE_DIR") && $cmd"
}

if [ "$use_cache" -eq 1 ]; then
  mkdir -p "$CACHE_DIR"
  mode_tag="f"; [ "$dirs_mode" -eq 1 ] && mode_tag="d"
  [ "$follow" -eq 1 ] && mode_tag="${mode_tag}L"
  [ -n "$max_depth" ] && mode_tag="${mode_tag}m${max_depth}"
  key=$(printf '%s%s.%s' "$HOST" "$REMOTE_DIR" "$mode_tag" | tr -c 'A-Za-z0-9._-' '_')
  listing="$CACHE_DIR/$key.tsv"
  if [ "$refresh" -eq 1 ] || [ ! -s "$listing" ]; then
    build_listing > "$listing"
    origin="fresh walk, now cached"
  else
    age_min=$(( ( $(date +%s) - $(stat -f %m "$listing") ) / 60 ))
    origin="cached ${age_min}m ago -- cfetch -r to rebuild"
  fi
else
  listing=$(mktemp "${TMPDIR:-/tmp}/cfetch.XXXXXX")
  trap 'rm -f "$listing"' EXIT
  build_listing > "$listing"
  origin="fresh walk"
fi

[ -s "$listing" ] || { echo "cfetch: nothing found under $REMOTE_DIR" >&2; exit 1; }

# Human-readable sizes are rendered here rather than with remote numfmt, which
# rewrites the tab delimiter the path column depends on. This also strips du's
# "./" prefixes and drops its entry for the root itself, whose empty path would
# otherwise mean "transfer the entire tree".
human=$(awk -F'\t' 'BEGIN { OFS = "\t" }
  {
    p = $2
    sub(/^\.\//, "", p)
    if (p == "" || p == ".") next
    s = $1; u = "B"
    if      (s >= 1073741824) { s /= 1073741824; u = "G" }
    else if (s >= 1048576)    { s /= 1048576;    u = "M" }
    else if (s >= 1024)       { s /= 1024;       u = "K" }
    printf "%6.1f%s\t%s\n", s, u, p
  }' "$listing")

[ -n "$human" ] || { echo "cfetch: nothing found under $REMOTE_DIR" >&2; exit 1; }

if [ "$dirs_mode" -eq 1 ]; then
  what="$(printf '%s\n' "$human" | wc -l | tr -d ' ') dirs (aggregate size)"
else
  what="$(printf '%s\n' "$human" | wc -l | tr -d ' ') files"
fi

fzf_args=(
  --multi --height=80% --reverse
  --delimiter=$'\t' --nth=2..
  --bind 'ctrl-a:select-all,ctrl-d:deselect-all'
  --header "$REMOTE_DIR on $HOST -- $what, $origin
Tab marks, ctrl-a takes all matches, Enter transfers to $DEST"
)

if [ "$preview" -eq 1 ]; then
  if [ "$dirs_mode" -eq 1 ]; then
    fzf_args+=(--preview "ssh $HOST 'ls -lah $(shquote "$REMOTE_DIR")/{2}' 2>/dev/null")
  else
    fzf_args+=(--preview "ssh $HOST 'head -c 4000 $(shquote "$REMOTE_DIR")/{2}' 2>/dev/null")
  fi
  fzf_args+=(--preview-window 'right:50%:wrap')
fi

selection=$(printf '%s\n' "$human" | fzf "${fzf_args[@]}") || true
[ -n "$selection" ] || { echo "cfetch: nothing selected, no files transferred." >&2; exit 0; }

mkdir -p "$DEST"

# --files-from implies --relative, so the tree under REMOTE_DIR is recreated
# under DEST rather than every file landing flat in one directory. It also
# leaves recursion off regardless of -a, which is right for a list of files and
# wrong for a list of directories -- hence the explicit -r in directory mode.
rsync_args=(-avhP)
[ "$dirs_mode" -eq 1 ] && rsync_args+=(-r)
[ "$follow" -eq 1 ] && rsync_args+=(--copy-links)
[ "$dry_run" -eq 1 ] && rsync_args+=(-n)
rsync_args+=(--files-from=- "$HOST:$REMOTE_DIR/" "$DEST/")

printf '%s\n' "$selection" | cut -f2- | rsync "${rsync_args[@]}"
